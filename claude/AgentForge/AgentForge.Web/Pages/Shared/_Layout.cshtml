@{
    var refresh = ViewData["MetaRefresh"] as int?;
}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (refresh is int seconds)
    {
        <meta http-equiv="refresh" content="@seconds" />
    }
    <title>@ViewData["Title"] - AgentForge</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <a href="/" class="brand">AgentForge</a>
        <span class="topbar-tag">Red Team / Penetration Harness — OpenEMR Clinical Co-Pilot</span>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="topbar-right">
                <span class="muted">@User.Identity.Name</span>
                <form method="post" action="/Logout" class="auth-logout">
                    <button type="submit" class="btn-link">Sign out</button>
                </form>
            </div>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>

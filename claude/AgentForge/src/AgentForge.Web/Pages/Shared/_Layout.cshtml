@{
    var refresh = ViewData["MetaRefresh"] as int?;
}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (refresh is int seconds)
    {
        <meta http-equiv="refresh" content="@seconds" />
    }
    <title>@ViewData["Title"] - AgentForge</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <h1><a href="/">AgentForge</a></h1>
        <p class="lede">Red Team / Penetration Harness for the OpenEMR Clinical Co-Pilot</p>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="auth-bar">
                <span class="muted">Signed in as <strong>@User.Identity.Name</strong></span>
                <form method="post" action="/Logout" class="auth-logout">
                    <button type="submit" class="btn-link">Sign out</button>
                </form>
            </div>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>

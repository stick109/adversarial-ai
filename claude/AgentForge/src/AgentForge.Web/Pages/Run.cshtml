@page "/Run/{id:int}"
@model RunModel
@{
    ViewData["Title"] = $"Run #{Model.Run!.Id}";

    string Duration()
    {
        var end = Model.Run.FinishedAt ?? DateTime.UtcNow;
        return $"{(end - Model.Run.StartedAt).TotalSeconds:0.0} s";
    }
}

<p><a href="/">&larr; Dashboard</a></p>

<h2>RedTeam run #@Model.Run!.Id</h2>

<div class="panel">
    <dl class="kv">
        <dt>Status</dt><dd class="status-@Model.Run.Status">@Model.Run.Status</dd>
        <dt>Started (UTC)</dt><dd class="code">@Model.Run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt>Finished (UTC)</dt><dd class="code">@(Model.Run.FinishedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</dd>
        <dt>Duration</dt><dd>@Duration()</dd>
        <dt>Exit code</dt><dd>@(Model.Run.ExitCode?.ToString() ?? "—")</dd>
        <dt>Result test id</dt><dd>@(Model.Run.ResultTestId?.ToString() ?? "—")</dd>
    </dl>
    @if (Model.Run.Status == "running")
    {
        <p class="muted">Page auto-refreshes every 2 seconds while the run is in flight.</p>
    }
    @if (Model.Run.ErrorMessageId is int errId)
    {
        <h3>Error</h3>
        <p><a href="/ErrorMessage/@errId">show error message #@errId</a></p>
    }
</div>

@if (Model.Test is not null)
{
    <h2>Inserted PenetrationTests row</h2>

    <div class="panel">
        <dl class="kv">
            <dt>Id</dt><dd>@Model.Test.Id</dd>
            <dt>Category</dt><dd>@Model.Test.Category</dd>
            <dt>Model</dt><dd class="code">@(Model.Test.GeneratorModel ?? "—")</dd>
            <dt>Created (UTC)</dt><dd class="code">@Model.Test.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            <dt>Description</dt><dd>@Model.Test.Description</dd>
        </dl>

        <h3>Bootstrap</h3>
        <pre>@Model.BootstrapJson</pre>

        <h3>Turns</h3>
        <pre>@Model.TurnsJson</pre>

        @if (Model.Executions.Count > 0)
        {
            <h3>Executions of this test (latest @Model.Executions.Count)</h3>
            <table>
                <thead><tr><th>Id</th><th>ExecutedAt (UTC)</th><th>Outcome</th><th>Error</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Executions)
                {
                    <tr>
                        <td class="num">@e.Id</td>
                        <td class="code">@e.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="outcome-@e.Outcome">@e.Outcome</td>
                        <td>@(e.ErrorClass ?? "")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted">This test has not been executed by the Harness yet. Run <code>dotnet run --project src\AgentForge.Harness</code> to exercise it.</p>
        }
    </div>
}
